#!/bin/sh
# ---------- pre-push：推送前的最后一道门 ----------
#
# 为什么这些检查不能在 pre-commit 做：
#   「本地必须已全部推送」这一条件在提交阶段天然不成立——
#   刚刚的提交本身还没推，一拦就永远提交不上去；而 push 又必须先有提交。
#   2026-11-26 就因为这个死锁，一次正常的提交被反复拦下。
#
# 这里做四件事：
#   1. 分支是否落后远端（落后时推送会被拒或产生非快进合并）
#   2. 待推送提交里有没有夹带敏感文件
#   3. 待推送提交的更新日记日期是否仍然正确
#   4. 单元测试（本仓库有 1300+ 个，CI 会跑；本地不跑就等于把测试当摆设）
#
# 第 4 项为什么必须在 push 前：
#   2026-11-26 发 v1.0.4 时，把命中率从整数百分比改成两位小数，
#   只改了实现没改断言，本地只跑了冒烟编译就推了。
#   CI 的 Verify 阶段 1379 个测试里 5 个失败，三个 APK 全建好了却卡在
#   测试这关，Release job 被跳过，既没 tag 也没 Release。
#   CLAUDE.md:544 本来就写着「git push 前必跑单元测试」，
#   但靠人记容易漏，所以改成钩子硬拦。
#
# 注意：pre-push 的 stdin 会给出 refs，但不依赖它，直接比对 origin/<branch>。

set -u

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
green(){ printf '\033[32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$*"; }

fail=0
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
remote_ref="origin/${branch}"

echo "推送前检查（分支 ${branch}）"

# ---------- 1. 分支是否落后远端 ----------
if git rev-parse --verify -q "${remote_ref}" >/dev/null 2>&1; then
    behind=$(git rev-list --count "HEAD..${remote_ref}" 2>/dev/null || echo 0)
    if [ "${behind}" -gt 0 ]; then
        red "  ✘ 本地落后 ${remote_ref} ${behind} 个提交，先 pull --rebase 再推"
        fail=1
    else
        green "  ✔ 未落后远端"
    fi
else
    yellow "  · 远端还没有 ${branch}，将新建分支"
fi

# ---------- 1b. 并发构建/推送检测 ----------
# push 会触发 pre-push 单测，与正在跑的构建抢同一个 app/build。
# 2026-11-27 一天内因为并发失败 3 次：三个 push 同时跑单测，
# 两个 Gradle daemon 互发 --stop，日志报
#   "Gradle build daemon has been stopped: stop command received"
# 表现为「推送失败」但代码和网络都没问题。
#
# 注意这条必须放在 pre-push，不能只放 pre-commit：
# pre-commit 检查的是「提交前」，而并发实际发生在 push 阶段。
running=$(ps -ef 2>/dev/null | grep -c "[j]ava.*[G]radleWrapperMain" || true)
running=${running:-0}
if [ "${running}" -gt 1 ]; then
    red "  ✘ 已有 ${running} 个 Gradle 构建在跑，拒绝并发推送"
    ps -ef 2>/dev/null | grep "[j]ava.*[G]radleWrapperMain" \
        | awk '{print "      pid " $2 "  父 " $3}' | head -5
    echo "      并发会让两个构建互发 --stop，单测跑不起来，推送必然失败。"
    echo "      处理：等它们结束；确认放弃则 sh gradlew --stop 后重试。"
    fail=1
elif [ "${running}" -eq 1 ]; then
    yellow "  · 检测到 1 个 Gradle 进程在跑（可能是上一次残留），继续"
fi

# ---------- 2. 待推送提交里有没有敏感文件 ----------
if git rev-parse --verify -q "${remote_ref}" >/dev/null 2>&1; then
    range="${remote_ref}..HEAD"
else
    range="HEAD"
fi

sensitive=$(git diff --name-only "${range}" 2>/dev/null \
    | grep -Ei '(^|/)(local\.properties|keystore\.properties|\.env|id_rsa|id_ed25519|.*\.jks|.*\.keystore)$' \
    || true)
if [ -n "${sensitive}" ]; then
    red "  ✘ 待推送提交包含敏感文件："
    printf '%s\n' "${sensitive}" | sed 's/^/      /'
    fail=1
else
    green "  ✔ 无敏感文件"
fi

# ---------- 2b. 改了 app/src 就必须已出包并归档 ----------
#
# 为什么放在 pre-push：真实流程是「提交 → 出包 → 归档 → 推送」。
# 提交那一刻包里不可能含本次改动，所以这条只能在这里查。
# 原先错放在 pre-commit，与 build-lock 的「出包要求已提交」互相锁死。
#
# 判据：本次推送涉及 app/src 的 .kt/.xml 时，
# build-output 最新包的 mtime 必须晚于这些源文件的 mtime，且包内日记与 CHANGELOG 一致。
push_src=$(git diff --name-only "${range}" 2>/dev/null \
    | grep -E '^app/src/(main|debug|release|profile)/.*\.(kt|xml)$' || true)
OUT_DIR="${AIGO_BUILD_OUTPUT:-$HOME/workspace/build-output}"
if [ -n "${push_src}" ]; then
    newest_apk=$(ls -t "$OUT_DIR"/*.apk 2>/dev/null | head -1)
    if [ -z "${newest_apk}" ]; then
        red "  ✘ 本次推送改了 app/src，但 build-output 里没有包（出包后归档再推）"
        fail=1
    else
        apk_mtime=$(stat -c %Y "$newest_apk" 2>/dev/null || echo 0)
        src_mtime=$(printf '%s\n' "${push_src}" | while read -r f; do
            [ -f "$f" ] && stat -c %Y "$f"
        done | sort -n | tail -1)
        src_mtime=${src_mtime:-0}
        if [ "$src_mtime" -gt "$apk_mtime" ]; then
            red "  ✘ 改了源码但归档包更旧，先出包再推"
            echo "    最新包: $(basename "$newest_apk")"
            echo "    源码:   $(date -d "@$src_mtime" '+%m-%d %H:%M:%S' 2>/dev/null)"
            echo "    APK:    $(date -d "@$apk_mtime" '+%m-%d %H:%M:%S' 2>/dev/null)"
            fail=1
        elif [ -f scripts/check_apk_changelog.py ]; then
            if python3 scripts/check_apk_changelog.py "$newest_apk" >/tmp/prepush_apklog.log 2>&1; then
                green "  ✔ 已出包归档，包内日记与 CHANGELOG 一致"
            else
                red "  ✘ 包内更新日记与 CHANGELOG 不一致："
                sed 's/^/      /' /tmp/prepush_apklog.log | head -8
                fail=1
            fi
        else
            green "  ✔ 已出包归档"
        fi
    fi
else
    green "  ✔ 未改 app/src，无需出包"
fi

# ---------- 3. 更新日记日期 ----------
if [ -f scripts/check_changelog_date.py ]; then
    if python3 scripts/check_changelog_date.py >/tmp/prepush_changelog.log 2>&1; then
        green "  ✔ 更新日记日期"
    else
        red "  ✘ 更新日记日期与代码不一致："
        sed 's/^/      /' /tmp/prepush_changelog.log
        fail=1
    fi
fi

# ---------- 4. 单元测试 ----------
# 只在本次推送确实改动了 Kotlin 源码 / 测试时才跑：纯文档、纯资源、
# CI 配置这类改动跑 1300+ 个测试纯属浪费时间（冷态 9 分钟）。
#
# 环境变量：
#   AIGO_SKIP_TESTS=1  跳过（事后必须补跑 aigo test）
touched_kt=$(git diff --name-only "${range}" 2>/dev/null \
    | grep -E '^(app|terminal-[a-z]+)/src/.*\.kt$' || true)
if [ -n "${AIGO_SKIP_TESTS:-}" ]; then
    yellow "  · 已设 AIGO_SKIP_TESTS，跳过单测（事后必须补跑 aigo test）"
elif [ -z "${touched_kt}" ]; then
    green "  ✔ 未改 Kotlin，无需跑单测"
else
    echo "  跑单元测试（改了 $(printf '%s\n' "${touched_kt}" | wc -l) 个 .kt 文件，冷态最多数分钟）..."
    if sh gradlew :app:testUniversalDebugUnitTest >/tmp/prepush_test.log 2>&1; then
        green "  ✔ 单元测试通过"
    else
        # Gradle 非零退出有两种完全不同的原因，必须分开报：
        #   ① 测试真的失败了（有用例 FAILED）—— 代码问题，改代码
        #   ② 构建本身没跑起来（ksp IO 冲突、并发抢目录、缓存损坏）—— 环境问题，别改代码
        #
        # 2026-11-27 的教训：第 1 轮推送失败在资源打包阶段，
        # 测试任务一次都没执行（日志里 testUniversalDebugUnitTest 出现 0 次），
        # 但钩子笼统报「单元测试未过」。按这个提示去查测试代码，
        # 方向完全错了，差点误报「代码有 bug」。真实原因是并发构建抢 app/build。
        if grep -qE '^[a-zA-Z0-9_.]+ > .* FAILED| tests completed, [0-9]+ failed' /tmp/prepush_test.log; then
            red "  ✘ 单元测试未过（有用例失败，属代码问题）："
            grep -E 'FAILED|tests completed' /tmp/prepush_test.log | head -15 | sed 's/^/      /'
            echo "      完整日志: /tmp/prepush_test.log"
        else
            red "  ✘ 测试没跑起来（构建阶段失败，通常不是代码问题）："
            grep -E 'What went wrong|FAILED|error:|Could not|still writing' /tmp/prepush_test.log \
                | head -8 | sed 's/^/      /'
            echo "      完整日志: /tmp/prepush_test.log"
            echo
            yellow "      常见原因与处理："
            yellow "        · 有别的 Gradle 在跑：ps -ef | grep \"[j]ava.*gradle\""
            yellow "        · 中间产物被抢写：sh gradlew --stop && rm -rf app/build"
            yellow "        · 构建缓存损坏：rm -rf /root/.gradle-home/caches/build-cache-1"
        fi
        fail=1
    fi
fi

echo
if [ "${fail}" != "0" ]; then
    red "推送被拦下。修完再推，或紧急时 git push --no-verify（事后必须补跑 aigo-gate）"
    exit 1
fi

# ---------- 5. 同步规则副本到宿主与仓库 ----------
# 为什么挂在这里而不只在 aigo push：
#   直接 `git push` 不经过 aigo，规则改了却没同步到
#   ~/workspace/docs/ 与 docs/skills/，副本就落后了。
#   2026-11-27 实测：技能文件改过之后直接 git push，宿主那份还是旧的。
#
# 同步失败不阻断推送——它是副本维护，不是代码正确性。
# 但必须显示出来，让人知道副本可能过期。
if [ -x scripts/sync-rules-doc.sh ] || [ -f scripts/sync-rules-doc.sh ]; then
    if sh scripts/sync-rules-doc.sh 2>&1 | sed 's/^/    /'; then
        green "  ✔ 规则副本已同步"
    else
        yellow "  ⚠ 规则副本同步失败，可稍后手动 sh scripts/sync-rules-doc.sh"
    fi
    echo
fi

green "推送前检查通过"
exit 0
