#!/bin/sh
# ---------- pre-push：推送前的最后一道门 ----------
#
# 为什么这些检查不能在 pre-commit 做：
#   「本地必须已全部推送」这一条件在提交阶段天然不成立——
#   刚刚的提交本身还没推，一拦就永远提交不上去；而 push 又必须先有提交。
#   2026-11-26 就因为这个死锁，一次正常的提交被反复拦下。
#
# 这里做四件事：
#   1. 分支是否落后远端（落后时推送会被拒或产生非快进合并）
#   2. 待推送提交里有没有夹带敏感文件
#   3. 待推送提交的更新日记日期是否仍然正确
#   4. 单元测试（本仓库有 1300+ 个，CI 会跑；本地不跑就等于把测试当摆设）
#
# 第 4 项为什么必须在 push 前：
#   2026-11-26 发 v1.0.4 时，把命中率从整数百分比改成两位小数，
#   只改了实现没改断言，本地只跑了冒烟编译就推了。
#   CI 的 Verify 阶段 1379 个测试里 5 个失败，三个 APK 全建好了却卡在
#   测试这关，Release job 被跳过，既没 tag 也没 Release。
#   CLAUDE.md:544 本来就写着「git push 前必跑单元测试」，
#   但靠人记容易漏，所以改成钩子硬拦。
#
# 注意：pre-push 的 stdin 会给出 refs，但不依赖它，直接比对 origin/<branch>。

set -u

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
green(){ printf '\033[32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$*"; }

fail=0
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
remote_ref="origin/${branch}"

echo "推送前检查（分支 ${branch}）"

# ---------- 1. 分支是否落后远端 ----------
if git rev-parse --verify -q "${remote_ref}" >/dev/null 2>&1; then
    behind=$(git rev-list --count "HEAD..${remote_ref}" 2>/dev/null || echo 0)
    if [ "${behind}" -gt 0 ]; then
        red "  ✘ 本地落后 ${remote_ref} ${behind} 个提交，先 pull --rebase 再推"
        fail=1
    else
        green "  ✔ 未落后远端"
    fi
else
    yellow "  · 远端还没有 ${branch}，将新建分支"
fi

# ---------- 2. 待推送提交里有没有敏感文件 ----------
if git rev-parse --verify -q "${remote_ref}" >/dev/null 2>&1; then
    range="${remote_ref}..HEAD"
else
    range="HEAD"
fi

sensitive=$(git diff --name-only "${range}" 2>/dev/null \
    | grep -Ei '(^|/)(local\.properties|keystore\.properties|\.env|id_rsa|id_ed25519|.*\.jks|.*\.keystore)$' \
    || true)
if [ -n "${sensitive}" ]; then
    red "  ✘ 待推送提交包含敏感文件："
    printf '%s\n' "${sensitive}" | sed 's/^/      /'
    fail=1
else
    green "  ✔ 无敏感文件"
fi

# ---------- 3. 更新日记日期 ----------
if [ -f scripts/check_changelog_date.py ]; then
    if python3 scripts/check_changelog_date.py >/tmp/prepush_changelog.log 2>&1; then
        green "  ✔ 更新日记日期"
    else
        red "  ✘ 更新日记日期与代码不一致："
        sed 's/^/      /' /tmp/prepush_changelog.log
        fail=1
    fi
fi

# ---------- 4. 单元测试 ----------
# 只在本次推送确实改动了 Kotlin 源码 / 测试时才跑：纯文档、纯资源、
# CI 配置这类改动跑 1300+ 个测试纯属浪费时间（冷态 9 分钟）。
#
# 环境变量：
#   AIGO_SKIP_TESTS=1  跳过（事后必须补跑 aigo test）
touched_kt=$(git diff --name-only "${range}" 2>/dev/null \
    | grep -E '^(app|terminal-[a-z]+)/src/.*\.kt$' || true)
if [ -n "${AIGO_SKIP_TESTS:-}" ]; then
    yellow "  · 已设 AIGO_SKIP_TESTS，跳过单测（事后必须补跑 aigo test）"
elif [ -z "${touched_kt}" ]; then
    green "  ✔ 未改 Kotlin，无需跑单测"
else
    echo "  跑单元测试（改了 $(printf '%s\n' "${touched_kt}" | wc -l) 个 .kt 文件，冷态最多数分钟）..."
    if sh gradlew :app:testUniversalDebugUnitTest >/tmp/prepush_test.log 2>&1; then
        green "  ✔ 单元测试通过"
    else
        red "  ✘ 单元测试未过："
        grep -E 'FAILED|tests completed' /tmp/prepush_test.log | head -15 | sed 's/^/      /'
        echo "      完整日志: /tmp/prepush_test.log"
        fail=1
    fi
fi

echo
if [ "${fail}" != "0" ]; then
    red "推送被拦下。修完再推，或紧急时 git push --no-verify（事后必须补跑 aigo-gate）"
    exit 1
fi

green "推送前检查通过"
exit 0
