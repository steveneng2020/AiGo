#!/bin/sh
# AiGo 构建与同步入口。
#
# 为什么有「主副本」这个概念（实测数据，2026-11-21，宿主 6 核持续高负载）：
#   workspace 是 App 通过 FUSE 暴露的持久化目录，瓶颈在元数据而非带宽：
#     单次 stat           ~99 ms   （本地磁盘 ~4 ms，24x）
#     遍历 2436 个文件     55.7 s   （本地磁盘 0.8 s，70x）
#     git status          30.0 s   （本地磁盘 1.5 s，20x）
#   Kotlin 编译要产出 5000+ class，在 workspace 里跑 30 分钟跑不完。
#   因此：日常开发/编译都在主副本，workspace 只作归档与宿主可见副本。
#
# 主副本为什么放在 /root/.aigo-build 而不是 /tmp：
#   实测容器内 /tmp 与 / 是同一个磁盘分区（df 同为 /dev/block/dm-37，
#   写 300MB 磁盘可用空间同步减少 300MB），本可持久；但 /tmp 语义上属于
#   临时目录，且宿主侧对该路径的清理策略不受我们控制。放进 /root 下的
#   自有目录，既在同一磁盘（同样快）又不会被任何清理规则误伤。
#
# 用法：
#   aigo status             看主副本状态
#   aigo pull               从源仓库重建主副本（首次或换设备，约 1 分钟）
#   aigo push [files...]    把改动写回源仓库（默认只写 git 认为有改动的文件）
#   aigo build [task]       在主副本编译（默认冒烟编译）
#   aigo apk                出可安装的 debug 包（最快，无需 R8）
#   aigo fast               出 release 包但跳过 R8（快 3~5 分钟，仅自测）
#   aigo test               跑单测（按改动筛测试类，快）
#   aigo test --all         跑全量单测（143 个类，8~9 分钟）
#   aigo gate [--fast]      跑完整门禁（敏感信息/迁移/品牌/编译/单测）
#   aigo release-check      检查并清理会污染 versionName 的临时 tag
#   aigo sync-archive      把归档副本快进到主副本 HEAD（秒级，手机 Git 面板立即可见）
#   aigo clean-shots       归档验收截图到 验收截图/<日期>/，并清理 7 天前的旧归档
#   aigo verify-push       确认本次 push 确实产生了 workflow run（防半成功推送）
#   aigo sync-fuse         整目录覆盖重建归档副本（5~10 分钟，换设备/重建时用）
#   aigo lock [status]      查看/管理构建锁（并发会在 acquire 时被拒）
#   aigo where              打印两个位置
#
# 实测耗时（宿主 6 核持续高负载下）：
#   无改动校验（daemon 预热 + 配置缓存命中）  22 ~ 24 s
#   全量编译（build 目录已存在）              1 min 30 s
#   改 1 个文件后增量编译                     47 s ~ 5 min（随宿主负载波动）
#   写回单个改动文件                          0.7 s
#   从源仓库重建主副本                        1 min 01 s

set -u

SRC="${AIGO_SRC:-/root/workspace/AiGo-Android源码仓库}"
MAIN="${AIGO_MAIN:-/root/.aigo-build}"

export JAVA_HOME=/usr/lib/jvm/java-17-openjdk
export ANDROID_HOME=/opt/android-sdk
export ANDROID_SDK_ROOT=/opt/android-sdk
export GRADLE_USER_HOME=/root/.gradle-home
# debug 包需要 ~/.android/debug.keystore，而 /root/.android 在本环境不可写
# （与 ~/.gradle 同源问题）。ANDROID_USER_HOME 让 AGP 改写到可写目录。
export ANDROID_USER_HOME=/root/.android-home
mkdir -p "$ANDROID_USER_HOME" 2>/dev/null || true

die() { echo "错误: $*" >&2; exit 1; }

cmd_pull() {
  [ -d "$SRC" ] || die "源仓库不存在: $SRC"

  # 护栏：源仓库落后主副本时拒绝重建。
  # cmd_pull 会 rm -rf 主副本再从源仓库拷，源仓库一旦落后，
  # 主副本上那些还没同步过去的提交就被物理删掉了（不是 reset，是没备份）。
  # 曾发生过源仓库落后 11 个提交、且缺 CHANGELOG.md 与 parse-changelog.py，
  # 此时跑 pull 等于一次性摧毁这段时间的全部工作。
  #
  # 不能用 `git -C "$SRC" rev-list HEAD..<main HEAD>` 判断：源仓库根本没那些对象，
  # 命令直接失败，被 || 吞成 0 后护栏形同虚设（实际踩过）。
  # 改用「主副本 HEAD 的对象是否存在于源仓库」——不存在就一定落后。
  if [ -d "$MAIN/.git" ] && [ -d "$SRC/.git" ]; then
    main_head=$(git -C "$MAIN" rev-parse HEAD 2>/dev/null || true)
    if [ -n "$main_head" ] && ! git -C "$SRC" cat-file -e "$main_head" 2>/dev/null; then
      die "源仓库缺少主副本 HEAD(${main_head%??????????????????????????????})，拒绝重建。
  先把主副本推过去: aigo sync-fuse"
    fi
  fi

  echo "从 $SRC 建立主副本 $MAIN（约 1 分钟）"
  rm -rf "$MAIN"; mkdir -p "$MAIN"
  cp -a "$SRC/." "$MAIN/" || die "复制失败"
  echo "sdk.dir=/opt/android-sdk" > "$MAIN/local.properties"
  echo "完成"
}

# 推送到 GitHub：直接从主副本推，不经 FUSE。
# 实测主副本 git status 0.64s、凭据可用；而经 FUSE 中转要 tar 打包再解包 5~10 分钟，
# 那一步纯属多余（FUSE 目录只是给宿主文件管理器看的一份副本）。
cmd_push() {
  [ -d "$MAIN/.git" ] || die "主副本不存在: $MAIN"
  cd "$MAIN" || die "进入失败"

  # 拆出只给闭环用的参数（--wait），其余原样传给 git push。
  wait_opt=""
  git_args=""
  for arg in "$@"; do
    case "$arg" in
      --wait|--wait=*) wait_opt="$arg" ;;
      *) git_args="$git_args $arg" ;;
    esac
  done

  # push 会触发 pre-push 单测，同样需要独占构建资源。
  sh "$MAIN/scripts/build-lock.sh" acquire "aigo push $*" || exit 1
  trap 'rc=$?; sh "$MAIN/scripts/build-lock.sh" release; exit $rc' EXIT INT TERM

  echo "从主副本直接推送 $MAIN"
  # shellcheck disable=SC2086
  git push origin HEAD $git_args || die "推送失败"
  # 推完立刻同步归档副本：手机 Git 面板看的是 $SRC，不同步就看不到新提交。
  cmd_sync_archive || echo "（归档副本同步失败，可稍后手动 aigo sync-archive）"
  # 顺带把 CLAUDE.md 与技能拷到 docs/，让规则变更也随推送落到宿主可见处。
  cmd_sync_rules
  # 闭环：确认触发 + 等结果（带 --wait 时）。
  # shellcheck disable=SC2086
  cmd_verify_push $wait_opt
}

# 推送后闭环：确认 push 真触发了 workflow，并且跑出了结果。
#
# 两个阶段都必需：
#   触发阶段 —— 2026-11-22 踩过：git push 报 TLS/RPC 错误但 ref 已更新，
#               事件没投递，Actions 一次没跑，git ls-remote 却显示代码在。
#   结果阶段 —— 触发了不等于通过。Beta Build 曾因单测变体选错连续 5 次
#               变红，而本地只看「已推送」完全无感。
#
# 默认只做触发检查（秒级）；加 --wait[=分钟] 连结果一起等。
# 返回码：0 正常；1 未触发或失败；2 无法查询（网络/限流，不算错误）。
cmd_verify_push() {
  command -v curl >/dev/null 2>&1 || { echo "（无 curl，跳过 push 闭环检查）"; return 0; }

  wait_min=0
  for arg in "$@"; do
    case "$arg" in
      --wait) wait_min=10 ;;
      --wait=*) wait_min="${arg#--wait=}" ;;
    esac
  done

  sha=$(git -C "$MAIN" rev-parse HEAD 2>/dev/null) || return 0
  short=$(echo "$sha" | cut -c1-7)

  echo "等待 Actions 接收 push 事件…"
  sleep 12

  # 先只查触发：不等待结果时用短超时。
  out=$(cd "$MAIN" && python3 scripts/check_actions.py --sha "$sha" \
        ${wait_min:+--wait "$wait_min"} 2>&1)
  rc=$?
  echo "$out" | sed 's/^/  /'

  case $rc in
    0) return 0 ;;
    2)
      echo "  （无法查询 Actions，可能限流；稍后 aigo verify-push --wait）"
      return 0
      ;;
    *)
      if echo "$out" | grep -q NOTRIGGERED; then
        echo "  [WARN] push 事件可能未投递（远端 ref 已更新但无 run）"
        echo "         处理：Actions 页手动 Run workflow，或改动一行再推一次"
      elif echo "$out" | grep -q PENDING; then
        echo "  [WARN] 还有 run 在跑，稍后复查：aigo verify-push --wait"
      else
        echo "  [FAIL] workflow 运行失败，处置："
        echo "         1) 看失败步骤：aigo logs <run_id>"
        echo "         2) 本地复现：aigo test / aigo build"
        echo "         3) 修完再推；不要因为 CI 红就跳过"
      fi
      return 1
      ;;
  esac
}

# 把主副本同步到 FUSE 源仓库，供宿主文件管理器查看/备份。
# 只在需要时手动调用，不参与日常推送流程。
cmd_sync_fuse() {
  [ -d "$MAIN/.git" ] || die "主副本不存在: $MAIN"
  [ -d "$SRC" ] || die "源仓库不存在: $SRC"
  echo "同步 $MAIN -> $SRC（约 5~10 分钟，FUSE 元数据慢）"
  # 排除 gitignore 里的内容（design-demos、__pycache__ 等），源仓库只放受版本管理的文件。
  # 注意 --exclude 必须写在 . 之前，且要匹配 ./ 前缀。
  tar -cf /tmp/aigo-fuse.tar -C "$MAIN" --exclude=./build --exclude=./app/build \
      --exclude=./.gradle --exclude=./local.properties \
      --exclude=./design-demos --exclude='./scripts/__pycache__' \
      --exclude='./app/build' . 2>/dev/null || die "打包失败"
  rm -rf "$SRC/.git"
  # 必须解到空目录：tar -xf 只覆盖同名文件，不会删除目标端多出来的文件。
  # 直接在 $SRC 上解包时，主副本删掉的截图/目录会永远残留在源仓库里，
  # 表现为「源仓库 git status 出现一堆 ?? 未跟踪文件」，且宿主文件管理器看到的
  # 是过期内容（曾因此误以为最新提交停在 7 小时前）。
  rm -rf "$SRC"
  mkdir -p "$SRC"
  tar -xf /tmp/aigo-fuse.tar -C "$SRC" || die "解包失败"
  rm -f /tmp/aigo-fuse.tar
  echo "完成"
}

# 轻量同步归档副本：只快进 git 历史，不搬文件。
#
# 用户在手机 Git 面板里看的是 $SRC（FUSE 归档），日常开发在 $MAIN。
# 两者不自动同步，导致「明明推了却看不到」。
# 与 sync-fuse 的区别：那个是整目录覆盖 + 重建 .git（5~10 分钟），
# 适合换设备重建；日常只需 fetch + merge --ff-only，秒级完成。
cmd_sync_archive() {
  [ -d "$MAIN/.git" ] || die "主副本不存在: $MAIN"
  [ -d "$SRC/.git" ] || die "归档副本不存在: $SRC"

  # 归档副本有未提交改动时不硬来，先报出来让用户决定。
  dirty=$(cd "$SRC" && git status --porcelain 2>/dev/null | wc -l)
  if [ "$dirty" -gt 0 ]; then
    echo "归档副本有 $dirty 项未提交改动，跳过同步。"
    echo "先处理掉（或在那边提交），否则快进会被拒。"
    (cd "$SRC" && git status --short | head -10)
    return 1
  fi

  target=$(cd "$MAIN" && git rev-parse HEAD)
  current=$(cd "$SRC" && git rev-parse HEAD 2>/dev/null || echo '')
  if [ "$current" = "$target" ]; then
    echo "归档副本已是最新（$(echo $target | cut -c1-7)）"
    return 0
  fi

  echo "同步归档副本 $(echo $current | cut -c1-7) -> $(echo $target | cut -c1-7)"
  # 直接从主副本 fetch（不走网络，FUSE 上只写 git 对象）。
  (cd "$SRC" && git fetch "$MAIN" HEAD 2>&1 | tail -2) || die "fetch 失败"
  (cd "$SRC" && git merge --ff-only FETCH_HEAD 2>&1 | tail -3) || {
    echo "快进失败：两边历史已分叉，需要人工处理（不要 reset --hard）。"
    return 1
  }
  echo "完成：$(cd "$SRC" && git log --oneline -1)"
}

# 发版：检查并清理会让 git describe 失真的残留 tag。
# CI 手动触发用过 manual-N 这类临时 tag 后，若遗留在本地，
# git describe 会返回 manual-N-x-g<hash>，versionName 被污染成
# 「1.0.0-dev+manual-2-2-gd31b1c0.20261121」，最终产物名与版本号都不对。
cmd_release_check() {
  [ -d "$MAIN/.git" ] || die "主副本不存在: $MAIN"
  cd "$MAIN" || die "进入失败"
  bad_tags=$(git tag -l | grep -E '^(manual-|tmp-|test-)' || true)
  if [ -n "$bad_tags" ]; then
    echo "发现临时 tag（会污染 versionName）："
    printf '%s\n' "$bad_tags" | sed 's/^/    /'
    echo "清理："
    printf '%s\n' "$bad_tags" | while read -r t; do
      [ -n "$t" ] && git tag -d "$t" >/dev/null 2>&1 && echo "    已删本地 $t"
    done
  else
    echo "无临时 tag"
  fi
  echo "当前 git describe: $(git describe --tags --always --dirty)"
}

cmd_build() {
  [ -d "$MAIN" ] || die "主副本不存在，先执行: aigo pull"
  # 构建互斥：并发会互相 --stop、共用 app/build，产物不可信（一天踩过 4 次）。
  # 锁在实践中比文档有效——规则写在天上，脚本拦在面前。
  sh "$MAIN/scripts/build-lock.sh" acquire "aigo build $*" || exit 1
  # trap 里显式保留退出码：直接 trap 'release' EXIT 会让 shell 用 trap 命令的
  # 退出码覆盖真实结果，导致构建失败也报 exit 0。
  trap 'rc=$?; sh "$MAIN/scripts/build-lock.sh" release; exit $rc' EXIT INT TERM
  task="${1:-:app:compileUniversalDebugKotlin}"
  shift 2>/dev/null || true
  cd "$MAIN" || die "进入 $MAIN 失败"
  # 不要加 --no-daemon / --no-parallel：daemon 复用时无改动校验 22s，
  # 加 --no-daemon 后同操作 4 分 52 秒（每次重启 JVM 并重算配置）。
  echo "在 $MAIN 执行 $task"
  # 不能用 exec：exec 会用 gradlew 进程替换当前 shell，调用方（如 cmd_apk）
  # 在 cmd_build 返回后的 copy_apk 永远不会执行，表现为「打了包但 build-output 里没有产物」。
  sh gradlew "$task" "$@"
}

# 单测。默认按改动筛测试类（快），--all 跑全量。
#
# 为什么默认筛选：全量 143 个测试类要 8~9 分钟，只改一行文案也要等这么久。
# 但安全性不打折——CI 的 verify job 始终全量跑，本地只看「明显被影响的」。
#
# 筛选逻辑见 scripts/select_tests.py：
#   同名测试类 + 同包测试类；core/**、domain/**、构建配置一律全量。
cmd_test() {
  all=0
  for arg in "$@"; do
    [ "$arg" = "--all" ] && all=1
  done

  if [ "$all" = "1" ]; then
    echo "全量单测（143 个类，约 8~9 分钟）"
    cmd_build :app:testUniversalDebugUnitTest
    return
  fi

  selector="$MAIN/scripts/select_tests.py"
  if [ ! -f "$selector" ]; then
    cmd_build :app:testUniversalDebugUnitTest
    return
  fi

  # 先看筛选结果：没有要跑的测试就直接返回，不要空跑 Gradle
  # （空 --tests 会让 Gradle 报 No tests found，白等 40 秒）。
  report=$(python3 "$selector" 2>&1)
  if ! printf '%s' "$report" | grep -q "选中\|跑全量"; then
    printf '%s\n' "$report"
    return
  fi
  args=$(python3 "$selector" --gradle-args 2>/dev/null)
  if [ -z "$args" ]; then
    printf '%s\n' "$report"
    return
  fi

  echo "按改动筛选单测（CI 仍跑全量兜底）"
  python3 "$selector" | head -20
  echo
  # shellcheck disable=SC2086
  eval "cmd_build :app:testUniversalDebugUnitTest $args"
}

# 本地要出可安装包时用这个：debug 变体，无需 R8，缓存命中约 30~60 秒。
# 用 armsolo（仅 arm64-v8a）：universal 含两套容器镜像，体积大、打包慢，
# 本机调试只需要 arm64。要出通用包走 CI 或显式传 flavor。
cmd_apk() {
  # 出包前先确认 CHANGELOG 已就绪：它是构建时打进 APK 的，
  # 顺序错了（先出包、后改日记）只能重新出包才生效。
  check_changelog_ready || return 1
  cmd_build :app:assembleArmsoloDebug "$@"
  copy_apk armsolo debug
}

# CHANGELOG 就绪检查：日期是今天或昨天、有条目、格式能被 App 端解析。
check_changelog_ready() {
  local script="$MAIN/scripts/check_changelog_ready.py"
  if [ -f "$script" ]; then
    python3 "$script" || { echo; echo "先改好更新日记再出包（见上面提示）"; return 1; }
  fi
}

# 出包后统一命名与归档。
#
# 目录：/storage/emulated/0/Download/AiGo/AiGo开发/build-output（容器内即 ~/workspace/build-output）
# 命名：AiGo-<类别>-<版本号>-<构建日期>-<更新摘要>.apk
#   <类别>：debug（测试包）/ release（正式包）
#   <构建日期>：YYYYMMDD-HHMM
#   <更新摘要>：取 CHANGELOG 对应版本首条要点，没有则退回提交标题
# 例：AiGo-debug-1.0.1-20261123-0215-插件导出与图标修复.apk
copy_apk() {
  flavor="${1:-armsolo}"
  build="${2:-debug}"
  src="$MAIN/app/build/outputs/apk/$flavor/$build/app-$flavor-$build.apk"
  [ -f "$src" ] || { echo "未找到产物: $src"; return 0; }

  aapt2=/opt/android-sdk/build-tools/35.0.0/aapt2
  ver=$("$aapt2" dump badging "$src" 2>/dev/null | head -1 | grep -o "versionName='[^']*'" | cut -d"'" -f2)
  [ -n "$ver" ] || ver="unknown"

  # 摘要优先级：CHANGELOG 当前版本概述 > 提交标题。
  # 先按 versionName 找（最准：APK 里就是 1.0.1），再退回版本 tag。
  # 不能只用 tag：本地还有保护 tag（pre-merge-*），describe 会取到它；
  # 且新版本未打 tag 时 tag 还停在上一版，摘要会张冠李戴。
  ver_core=$(printf '%s' "$ver" | sed 's/-.*$//')
  summary=$(cd "$MAIN" && python3 scripts/parse-changelog.py --summary-for "v$ver_core" 2>/dev/null || true)
  if [ -z "$summary" ]; then
    tag=$(cd "$MAIN" && git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)
    if [ -n "$tag" ]; then
      summary=$(cd "$MAIN" && python3 scripts/parse-changelog.py --summary-for "$tag" 2>/dev/null || true)
    fi
  fi
  if [ -z "$summary" ]; then
    summary=$(cd "$MAIN" && git log -1 --format=%s 2>/dev/null)
    summary=$(printf '%s' "$summary" | sed -E 's/^[a-z]+(\([^)]*\))?:[[:space:]]*//')
  fi

  # 文件名安全化：去掉路径分隔符、Windows 非法字符与中文标点，压缩空白。
  # 截断用 python 按字符处理，避免 cut -c 按字节切断中文产生乱码。
  # 限 16 字：APK 文件名太长在手机上会显示成省略号，也容易被某些文件管理器截断。
  ver=$(printf '%s' "$ver" | tr '+' '-')
  summary=$(printf '%s' "$summary" | python3 -c '
import re, sys
s = sys.stdin.read().strip()
s = re.sub(r"[\\/:|*?\"<>]", "-", s)
s = s.replace("，", "-").replace("、", "-").replace("。", "")
s = re.sub(r"\s+", "-", s)
s = re.sub(r"-+", "-", s).strip(" -")
print(s[:16])
' 2>/dev/null)
  [ -n "$summary" ] || summary="update"

  # 统一输出目录：宿主 /storage/emulated/0/Download/AiGo/AiGo开发/build-output
  # 容器内同路径即 ~/workspace/build-output。
  outdir="$HOME/workspace/build-output"
  mkdir -p "$outdir"

  # 清理策略：
  #   release —— 每个版本都保留，不删。正式包是发版存档，旧版本要能随时取回。
  #   debug   —— 只保留同版本最新一份，避免目录堆出多个同版本测试包分不清。
  ver_core=$(printf '%s' "$ver" | sed 's/-.*$//')
  if [ "$build" = "debug" ]; then
    for old in "$outdir"/AiGo-*-"$ver_core"-debug-*.apk; do
      [ -f "$old" ] && rm -f "$old" && echo "清理同版本旧测试包: $(basename "$old")"
    done
  fi

  stamp=$(date +%Y%m%d)
  # ABI：从 APK 自身读，不靠 flavor 推断（flavor 名与产物 abi 不一定同名）。
  abi=$("$aapt2" dump badging "$src" 2>/dev/null \
        | grep -o "native-code: *'[^']*'" | head -1 \
        | sed "s/.*'\([^']*\)'.*/\1/")
  [ -n "$abi" ] || abi="universal"
  # 多 ABI 时用 - 连接，保持文件名可读：arm64-v8a + x86_64 -> arm64-v8a+x86_64
  abi=$(printf '%s' "$abi" | tr ' ' '+')

  # 命名规则：AiGo-<abi>-<版本>-<摘要>-<构建日期>.apk
  # 类别（debug/release）放在摘要前作为“摘要”的前缀，
  # 这样既符合规则又能直接用文件名区分测试包与正式包。
  out="$outdir/AiGo-${abi}-${ver}-${build}-${summary}-${stamp}.apk"
  cp "$src" "$out" && echo "产物: $out"
}

# 本地要 release 包但不想等 R8：跳过混淆与资源压缩，快 3~5 分钟。
# 仅用于自测；正式发版走 CI，不要带 skipMinify。
cmd_fast() {
  cmd_build :app:assembleArmsoloRelease -PskipMinify "$@"
  copy_apk armsolo release
}

cmd_status() {
  [ -d "$MAIN/.git" ] || die "主副本不存在: $MAIN"
  cd "$MAIN" || die "进入失败"
  echo "== 分支 =="; git rev-parse --abbrev-ref HEAD
  echo "== 提交 =="; git log --oneline -1
  echo "== 改动 =="; git status --short | head -20
}

# 整理真机验收产物：把根目录散落的截图与临时库副本收进验收截图/。
#
# 验收时用 adb/root 截图会直接落在 AiGo开发/ 根目录（容器内 ~/workspace），
# 一轮下来几十个 v1.png/w2.png 堆在根目录，与 build-output、源码仓库混在一起。
# 按日期分子目录归档，保留最近 N 天，更早的清掉。
cmd_clean_shots() {
  root="$HOME/workspace"
  dest="$root/验收截图"
  [ -d "$root" ] || die "工作区不存在: $root"
  mkdir -p "$dest"

  moved=0
  # 根目录散落的 png 与临时库副本
  for f in "$root"/*.png "$root"/*.db "$root"/*.db-wal "$root"/*.db-shm; do
    [ -f "$f" ] || continue
    day=$(date -r "$f" +%Y%m%d 2>/dev/null || date +%Y%m%d)
    mkdir -p "$dest/$day"
    mv "$f" "$dest/$day/" && moved=$((moved + 1))
  done
  [ "$moved" -gt 0 ] && echo "已归档 $moved 个文件到 $dest"

  # 清理 N 天前的归档（默认 7 天，可用 AIGO_SHOT_KEEP_DAYS 覆盖）
  keep=${AIGO_SHOT_KEEP_DAYS:-7}
  cutoff=$(date -d "-$keep days" +%Y%m%d 2>/dev/null || echo "")
  if [ -n "$cutoff" ]; then
    removed=0
    for d in "$dest"/*/; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      case "$name" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
          if [ "$name" -lt "$cutoff" ]; then
            rm -rf "$d" && removed=$((removed + 1))
          fi
          ;;
      esac
    done
    [ "$removed" -gt 0 ] && echo "已清理 $removed 个超过 $keep 天的归档目录"
  fi

  echo "当前归档："
  du -sh "$dest" 2>/dev/null || true
  ls -1 "$dest" 2>/dev/null | head -10
}

cmd_where() {
  echo "源仓库（持久化，宿主可见）:"; echo "  $SRC"
  echo "  宿主: /storage/emulated/0/Download/AiGo/AiGo开发/AiGo-Android源码仓库"
  echo "主副本（持久化，日常开发与编译）:"; echo "  $MAIN"
}

# 把 AI 协作规则（CLAUDE.md + 5 个技能）拷到宿主可见的 docs 下。
# 这些文件平时住在容器内（$MAIN 与 ~/.nox/skills），手机上文件管理器看不到，
# 换设备或交接时容易丢。docs 下这份是只读副本，单向覆盖、不参与开发。
cmd_sync_rules() {
  script="$MAIN/scripts/sync-rules-doc.sh"
  if [ -f "$script" ]; then
    sh "$script" || echo "（规则同步失败，不影响推送结果）"
  fi
}

case "${1:-}" in
  build)  shift; cmd_build "$@" ;;
  apk)    shift; cmd_apk "$@" ;;
  gate)   shift; exec /root/bin/aigo-gate "$@" ;;
  release-check) cmd_release_check ;;
  fast)   shift; cmd_fast "$@" ;;
  test)   cmd_test ;;
  status) cmd_status ;;
  pull)   cmd_pull ;;
  push)   shift; cmd_push "$@" ;;
  sync-fuse) cmd_sync_fuse ;;
  sync-archive) cmd_sync_archive ;;
  sync-rules) cmd_sync_rules ;;
  lock)   shift; sh "$MAIN/scripts/build-lock.sh" "${@:-status}" ;;
  clean-shots) cmd_clean_shots ;;
  verify-push) shift; cmd_verify_push "$@" ;;
  where)  cmd_where ;;
  *)      sed -n '23,44p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
